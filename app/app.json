{
  "expo": {
    "name": "Tide",
    "slug": "tide",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/ios-light.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thisiskurubaran.tide",
      "icon": {
        "light": "./assets/icons/ios-light.png",
        "dark": "./assets/icons/ios-dark.png",
        "tinted": "./assets/icons/ios-tinted.png"
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeCrashData",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ]
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "appleTeamId": "9CYJBSWY2X",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "Tide connects to the Remote mode server you set up and to previews running on your local network.",
        "LSSupportsOpeningDocumentsInPlace": false,
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Source code and text",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.source-code",
              "public.script",
              "public.plain-text",
              "public.text",
              "public.json",
              "public.xml",
              "public.html",
              "public.css",
              "net.daringfireball.markdown"
            ]
          },
          {
            "CFBundleTypeName": "Zip archive",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.zip-archive"
            ]
          }
        ],
        "NSSupportsLiveActivities": true
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.thisiskurubaran.tide"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0e1a4d",
        "backgroundImage": "./assets/icons/android-background.png",
        "foregroundImage": "./assets/icons/android-foreground.png",
        "monochromeImage": "./assets/icons/android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.thisiskurubaran.tide",
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "content",
              "mimeType": "text/*"
            },
            {
              "scheme": "content",
              "mimeType": "application/json"
            },
            {
              "scheme": "content",
              "mimeType": "application/javascript"
            },
            {
              "scheme": "content",
              "mimeType": "application/x-python"
            },
            {
              "scheme": "content",
              "mimeType": "application/zip"
            },
            {
              "scheme": "content",
              "mimeType": "application/x-zip-compressed"
            }
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/icons/favicon.png"
    },
    "scheme": "tide",
    "plugins": [
      "./modules/python-runtime/app.plugin.js",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/splash.png",
          "backgroundColor": "#0d0f0e",
          "imageWidth": 120
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/InstrumentSans-Medium.ttf",
            "./assets/fonts/InstrumentSans-SemiBold.ttf",
            "./assets/fonts/Inter-Medium.ttf",
            "./assets/fonts/Inter-Regular.ttf",
            "./assets/fonts/Inter-SemiBold.ttf",
            "./assets/fonts/JetBrainsMono-Regular.ttf",
            "./assets/fonts/JetBrainsMono-SemiBold.ttf"
          ]
        }
      ],
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-iap",
      "./plugins/withLocalPreview.js",
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Midnight",
            "ios": {
              "light": "./assets/icons/ios-midnight.png",
              "dark": "./assets/icons/ios-midnight-dark.png",
              "tinted": "./assets/icons/ios-midnight-tinted.png"
            },
            "android": {
              "foregroundImage": "./assets/icons/android-midnight-foreground.png",
              "backgroundColor": "#0b1022"
            }
          }
        ]
      ],
      "@bacons/apple-targets",
      "./plugins/withAppIntents.js"
    ]
  }
}
