# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# nodejs-mobile writes these on install with the local PATH baked in
nodejs-assets/build-native-modules-MacOS-helper-script-*.sh

# Fetched on install by modules/python-runtime/scripts/fetch-ios-python.js
modules/python-runtime/ios/Python.xcframework/

# Vite output; the app uses the generated .ts files instead
web/*/dist/
__pycache__/

# Generated by scripts/build-services.js on npm install
nodejs-assets/nodejs-project/format/bundle.js
nodejs-assets/nodejs-project/intellisense/typescript.js
nodejs-assets/nodejs-project/intellisense/lib/

# Fetched by modules/python-runtime/scripts/fetch-python-tools.js on npm install
modules/python-runtime/python/.tide-tools
modules/python-runtime/python/pyflakes/
modules/python-runtime/python/pyflakes-*.dist-info/
modules/python-runtime/python/autopep8.py
modules/python-runtime/python/autopep8-*.dist-info/
modules/python-runtime/python/pycodestyle.py
modules/python-runtime/python/pycodestyle-*.dist-info/
